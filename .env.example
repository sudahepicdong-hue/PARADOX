# Salin file ini menjadi .env lalu isi nilainya.

# --- Supabase (dipakai website) ---
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxx"

# --- Supabase (HANYA untuk `npm run db:setup`, jangan pakai awalan VITE_) ---
# Supabase Dashboard > tombol "Connect" > Session pooler > URI (ganti [YOUR-PASSWORD])
SUPABASE_DB_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Supabase (HANYA untuk `npm run functions:deploy`) ---
# https://supabase.com/dashboard/account/tokens > Generate new token
SUPABASE_ACCESS_TOKEN="sbp_xxxxxxxxxxxx"

# --- LiveKit (live streaming), HANYA untuk `npm run functions:deploy` ---
# Daftar gratis di https://cloud.livekit.io > buat project > Settings > Keys
LIVEKIT_URL="wss://nama-project.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxx"
LIVEKIT_API_SECRET="xxxxxxxxxxxxxxxx"

# --- Notifikasi Telegram ke admin (opsional), HANYA untuk `npm run functions:deploy` ---
# 1. Chat @BotFather di Telegram > /newbot > salin token-nya ke sini
# 2. Kirim /start ke bot itu dari akun admin, lalu jalankan: npm run telegram:chat-id
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
# Bot BARU khusus talent (status Online/Offline lewat /online & /offline). Jangan sama dengan bot admin.
TELEGRAM_TALENT_BOT_TOKEN=""
# Alamat website (untuk link di pesan Telegram), contoh: https://paradox.sevalla.app
PUBLIC_SITE_URL=""

# Cloudflare Turnstile (verifikasi bukan bot). Site Key juga diisi di Sevalla; Secret Key JANGAN ke Sevalla.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
